aus: 'Australia' };\nfunction normalizeState(value) {\n  const s = String(value === undefined || value === null ? '' : value).trim();\n  if (s === '') return '';\n  const key = s.toLowerCase().replace(/[.\\s]/g, '');\n  return US_STATES[key] || capitalizeName(s);\n}\nfunction normalizeCountry(value) {\n  const s = String(value === undefined || value === null ? '' : value).trim();\n  if (s === '') return '';\n  const key = s.toLowerCase().replace(/[.\\s]/g, '');\n  return COUNTRIES[key] || capitalizeName(s);\n}\nfunction resolveName() {\n  const explicitFirst = pick(['first name', 'firstname', 'first']);\n  const explicitLast = pick(['last name', 'lastname', 'last']);\n  const combinedName = pick(['name', 'full name', 'fullname']);\n  let firstname = explicitFirst;\n  let lastname = explicitLast;\n  let nameSplit = false;\n  let combinedSource = '';\n  if (explicitFirst === '' && explicitLast === '' && combinedName !== '') {\n    combinedSource = combinedName;\n  } else if (explicitLast === '' && /\\s/.test(explicitFirst)) {\n    combinedSource = explicitFirst;\n  }\n  if (combinedSource !== '') {\n    const parts = combinedSource.split(/\\s+/).filter(function (p) { return p !== ''; });\n    if (parts.length >= 2) {\n      firstname = parts[0];\n      lastname = parts.slice(1).join(' ');\n      nameSplit = true;\n    } else {\n      firstname = combinedSource;\n      lastname = '';\n    }\n  }\n  return {\n    firstname: capitalizeName(firstname),\n    lastname: capitalizeName(lastname),\n    nameSplit: nameSplit,\n  };\n}\nconst name = resolveName();\nreturn {\n  json: {\n    email: pick(['email', 'email address', 'e-mail']),\n    firstname: name.firstname,\n    lastname: name.lastname,\n    nameSplit: name.nameSplit,\n    company: pick(['company', 'company name', 'organization', 'organisation']),\n    phone: pick(['mobile phone', 'mobile number', 'phone', 'phone number', 'telephone', 'mobile', 'cell', 'cell phone', 'contact number']),\n    city: pick(['city', 'town