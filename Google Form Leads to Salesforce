        "jsCode": "const row = $input.item.json;\nfunction pick(keys) {\n  for (const wantRaw of keys) {\n    const want = String(wantRaw).toLowerCase().trim();\n    for (const k of Object.keys(row)) {\n      if (k.toLowerCase().trim() === want) {\n        const v = row[k];\n        if (v !== undefined && v !== null && String(v).trim() !== '') {\n          return String(v).trim();\n        }\n      }\n    }\n  }\n  return '';\n}\n// Normalize the casing of a single word.\n// - If the word is ALL UPPERCASE (e.g. \"JOHN\"), convert it to first-letter\n//   uppercase and the rest lowercase (e.g. \"John\").\n// - Otherwise, just capitalize the first letter and preserve the rest\n//   (keeps mixed-case names like \"McDonald\" or \"O'Brien\" intact).\nfunction normalizeWord(w) {\n  if (w === '') return '';\n  const isAllUpper = w === w.toUpperCase() && w !== w.toLowerCase();\n  const rest = isAllUpper ? w.slice(1).toLowerCase() : w.slice(1);\n  return w.charAt(0).toUpperCase() + rest;\n}\n// Capitalize each word of a name value.\nfunction capitalizeName(value) {\n  const s = String(value === undefined || value === null ? '' : value).trim();\n  if (s === '') return '';\n  return s.split(/\\s+/).map(normalizeWord).join(' ');\n}\n// Detect whether a combined name field can be split into first + last name.\n// Returns { firstname, lastname, nameSplit } where nameSplit is true when a\n// single full-name value was validated as splittable and divided.\nfunction resolveName() {\n  const explicitFirst = pick(['first name', 'firstname', 'first']);\n  const explicitLast = pick(['last name', 'lastname', 'last']);\n  const combinedName = pick(['name', 'full name', 'fullname']);\n  let firstname = explicitFirst;\n  let lastname = explicitLast;\n  let nameSplit = false;\n  // Pick the source that may hold both names in one field.\n  let combinedSource = '';\n  if (explicitFirst === '' && explicitLast === '' && combinedName !== '') {\n    combinedSource = combinedName;\n  } else if (explicitLast === '' && /\\s/.test(explicitFirst)) {\n    // The first-name field actually contains a full name.\n    combinedSource = explicitFirst;\n  }\n  if (combinedSource !== '') {\n    const parts = combinedSource.split(/\\s+/).filter(function (p) { return p !== ''; });\n    if (parts.length >= 2) {\n      firstname = parts[0];\n      lastname = parts.slice(1).join(' ');\n      nameSplit = true;\n    } else {\n      firstname = combinedSource;\n      lastname = '';\n    }\n  }\n  return {\n    firstname: capitalizeName(firstname),\n    lastname: capitalizeName(lastname),\n    nameSplit: nameSplit,\n  };\n}\nconst name = resolveName();\nreturn {\n  json: {\n    email: pick(['email', 'email address', 'e-mail']),\n    firstname: name.firstname,\n    lastname: name.lastname,\n    nameSplit: name.nameSplit,\n    company: pick(['company', 'company name', 'organization', 'organisation']),\n    phone: pick(['phone', 'phone number', 'telephone', 'mobile']),\n    city: pick(['city', 'town']),\n    state: pick(['state', 'province', 'region']),\n    country: pick(['country']),\n    title: pick(['title', 'job title', 'role']),\n    website: pick(['website', 'web', 'url']),\n  },\n};"
